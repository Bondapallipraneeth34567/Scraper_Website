# =====================================================================
# mandi_pipeline configuration.  Copy to .env on the VM (chmod 600) and
# fill in.  NEVER commit the real .env.  All secrets come from the
# environment -- nothing is hard-coded in source.
# =====================================================================

# --- Database (the shared "mandi" schema Postgres, same server the
#     dashboard backend uses -- see backend/db.js) --------------------
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# ...or the discrete parts (DATABASE_URL wins if both are set):
PG_HOST=localhost
PG_PORT=5432
PG_DB=voice_agent
PG_USER=mandi_pipeline
PG_PASSWORD=
PG_SSLMODE=prefer            # disable | prefer | require

TARGET_TABLE=mandi.market_prices_v3

# --- AGMARKNET direct API (Approach 1) ------------------------------
AGMARKNET_API_BASE=https://api.agmarknet.gov.in/v1
AGMARKNET_SITE_ORIGIN=https://agmarknet.gov.in
AGMARKNET_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
# Data only exists from AGMARKNET 2.0 go-live. Do not request earlier dates.
AGMARKNET_DATA_MIN_DATE=2025-11-07

# --- Politeness / rate handling (the API has an undocumented, header-less
#     throttle -- see README "Rate limiting") --------------------------
REQUEST_MIN_INTERVAL_SEC=8       # min gap between calls to the report endpoint
CAPTCHA_MIN_GAP_SEC=3            # min gap between the prev /report and the next captcha mint
HTTP_CONNECT_TIMEOUT_SEC=10
HTTP_READ_TIMEOUT_SEC=45
MAX_RETRIES=4                    # per call, on timeout / throttle / 5xx
BACKOFF_BASE_SEC=15             # exponential: 15, 30, 60, 120 ...
BACKOFF_MAX_SEC=300
SWEEP_PASSES=3                  # re-sweep still-missing commodities this many times
# A done/empty commodity older than this gets re-checked on the next run
# (catches late-reported markets). Keep it ~= the timer interval (4h) so a
# commodity is re-checked once per tick, NOT re-done mid-sweep. Raise it if
# a sweep runs longer than this -- watch rows_unchanged in pipeline_runs.
PROGRESS_REFRESH_AFTER_HOURS=4

# Skip commodities that return "No data available" every day (livestock,
# wood, exotic flowers -- ~335/605). Still re-checked every RECHECK_DAYS.
STALE_EMPTY_SKIP=true
STALE_EMPTY_WINDOW_DAYS=10
STALE_EMPTY_MIN_OBS=2
STALE_EMPTY_RECHECK_DAYS=7

# --- CAPTCHA handling -------------------------------------------------
# manual           = pause, wait for an authorised human in the console.
# easyocr          = local easyocr over a preprocessed image.
# llm              = a multimodal LLM reads the 6-char image.
# llm_assisted_ocr = easyocr fast path, LLM rescues the ambiguous reads
#                    (recommended automated mode).
CAPTCHA_SOLVER=manual
CAPTCHA_EXPECTED_LEN=6
CAPTCHA_LOCAL_ATTEMPTS=2         # easyocr preprocess variants before falling back
CAPTCHA_LLM_MODEL=              # blank -> use LLM_MODEL
CAPTCHA_DEBUG=false             # dump raw+preprocessed+guess to state/captcha/debug/
# AGMARKNET's CAPTCHA has NO audio alternative (verified: type=audio /
# format=audio params are ignored, /captcha/audio and
# /captcha/generator/audio both -> 404). So when an automated solver
# (easyocr/llm/llm_assisted_ocr) exhausts its attempts on a commodity, the
# only real backup is a human -- this escalates to ONE manual attempt
# before giving up. Has no effect when CAPTCHA_SOLVER=manual already.
CAPTCHA_MANUAL_FALLBACK=true
CAPTCHA_WAIT_TIMEOUT_SEC=1800    # manual mode only: wait for a human answer
CAPTCHA_STATE_DIR=mandi_pipeline/state/captcha

# Operator console (where the human sees the image and submits the answer)
OPERATOR_CONSOLE_HOST=127.0.0.1  # keep loopback; reach it over SSH tunnel / VPN
OPERATOR_CONSOLE_PORT=8770
OPERATOR_CONSOLE_TOKEN=          # required; generate: python -c "import secrets;print(secrets.token_urlsafe(24))"

# --- Optional LLM-assisted response classifier ----------------------
# Used ONLY when a response is not a clean success and matches none of the
# known error strings -- it classifies captcha_required | rate_limited |
# transient_error | schema_change | ok. Off by default.
LLM_CLASSIFIER_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- CSV output + Azure Blob mirror -------------------------------
# One CSV per commodity per day (same layout as the browser scraper's
# "Download CSV" archive). The local file is the staging copy; the blob
# is the durable one.
CSV_OUTPUT_ENABLED=true
CSV_OUTPUT_DIR=mandi_pipeline/state/downloads
CSV_LOCAL_KEEP=true              # false = delete local file after a confirmed blob upload
BLOB_UPLOAD_ENABLED=true         # auto-on when AZURE_STORAGE_CONNECTION_STRING is set
AZURE_STORAGE_CONNECTION_STRING= # same account the browser scraper uses
AZURE_STORAGE_CONTAINER=
BLOB_PREFIX=agmarknet_api/       # keeps these blobs separate from the browser scraper's

# --- Monitoring ----------------------------------------------------
LOG_DIR=mandi_pipeline/state/logs
LOG_LEVEL=INFO
HEARTBEAT_URL=                   # pinged on success (e.g. a healthchecks.io URL)
ALERT_WEBHOOK_URL=               # POSTed a JSON summary on failed/partial runs

# --- data.gov.in (Approach 2) ------------------------------------
# Register a PERSONAL key at https://data.gov.in (Google / gov email) ->
# profile -> generate API key. The shared demo key is rate-limited and did
# not accept filters[] in testing (which forces a 10k-row window cap).
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_TARGET_TABLE=mandi.market_prices_v4
DATA_GOV_IN_PAGE_SIZE=1000
DATA_GOV_IN_SKIP_IF_UNCHANGED=true     # skip the fetch when the resource's `updated` epoch hasn't moved
DATA_GOV_IN_READ_TIMEOUT_SEC=90        # the API is often slow
DATA_GOV_IN_MIN_INTERVAL_SEC=3         # spacing between calls (shared demo key throttles hard)
DATA_GOV_IN_SNAPSHOT_DIR=mandi_pipeline/state/datagovin/snapshots
DATA_GOV_IN_SNAPSHOT_KEEP=30
DATA_GOV_IN_WINDOW=10000               # API rejects offset+limit above this
